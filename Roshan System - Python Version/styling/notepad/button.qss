QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(75, 0, 255, 204), stop:1 rgba(0, 0, 255, 204));
    border: 2px solid white;
    border-radius: 10px;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(75, 0, 205, 204), stop:1 rgba(0, 0, 205, 204));
}