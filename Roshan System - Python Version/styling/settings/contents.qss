QTabWidget::pane {
    border: 1px solid rgba(124, 124, 124, 204);
    background-color: rgba(30, 30, 30, 204);
    top: -1px;
    border-radius: 4px;
}


QTabBar::tab {
    background: rgba(94, 94, 94, 204);
    border: 1px solid rgba(124, 124, 124, 204);
    border-bottom-color: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 80px;
    padding: 6px 12px;
    color: black;
}

QTabBar::tab:selected {
    background:  rgba(30, 30, 30, 204);
    border-bottom-color: rgba(30, 30, 30, 204);
    font-weight: bold;
    color: rgba(200, 200, 200, 204);
}

QTabBar::tab:hover:!selected {
    background: rgba(200, 200, 200, 204);
}
